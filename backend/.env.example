# Copy to backend/.env for local development. Every setting is prefixed HRMS_.
# In production set these in the environment (not a committed file) — see RUNBOOK.md "Production Build".

# ── Database ────────────────────────────────────────────────────────────────
# Owner/superuser connection: migrations and the scripts in backend/scripts/ only.
HRMS_DATABASE_URL=postgresql+asyncpg://hrms:hrms@localhost:5432/hrms
# The connection the RUNNING API uses: the restricted hrms_app role (NOSUPERUSER, NOBYPASSRLS), so
# Postgres row-level security enforces tenant isolation. Required when HRMS_ENVIRONMENT=production,
# and its password must not be the published development one.
HRMS_APP_DATABASE_URL=postgresql+asyncpg://hrms_app:hrms_app_dev_password@localhost:5432/hrms
# Password migration 0005 gives hrms_app when it first creates the role (default: hrms_app_dev_password).
# HRMS_APP_ROLE_PASSWORD=

# ── Security ────────────────────────────────────────────────────────────────
# development | production. Production refuses to start with the default signing key, a key
# shorter than 32 characters, debug on, no app database URL, or the published hrms_app password.
# local | testing | production — see docs/ENVIRONMENTS.md (testing holds real data: all safeguards).
HRMS_ENVIRONMENT=local
HRMS_SECRET_KEY=change-me-before-production
HRMS_DEBUG=false
HRMS_CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://testinghrms.alvision.in,http://testinghrms.alvision.in

# Sign-in protection (counted in the database, so it holds across workers and restarts).
# HRMS_LOGIN_MAX_FAILURES=5              # wrong passwords per identifier+address before a lockout
# HRMS_LOGIN_IDENTIFIER_MAX_FAILURES=25  # … per identifier from any address
# HRMS_LOGIN_IP_MAX_FAILURES=100         # … per address (generous: a factory can share one)
# HRMS_LOGIN_LOCKOUT_MINUTES=15
# HRMS_REGISTER_MAX_PER_HOUR=5           # anonymous company registrations per address
# HRMS_ALLOW_PUBLIC_REGISTRATION=true    # set false once tenants are created from the platform console

# ── Attendance fallback ─────────────────────────────────────────────────────
# Used only when no policy template applies to an employee, their department, company or tenant.
# Prefer giving each tenant its own default template (Policies → templates).
# HRMS_DEFAULT_TIMEZONE=Asia/Kolkata
# HRMS_DEFAULT_WORK_START=09:30
# HRMS_DEFAULT_WORK_END=18:30
# HRMS_DEFAULT_GRACE_LATE_MINUTES=15
# HRMS_DEFAULT_GRACE_EARLY_MINUTES=15

# ── Observability (docs/OBSERVABILITY.md) ────────────────────────────────────
# HRMS_LOG_FORMAT=console                  # json in production (the default there)
# HRMS_LOG_LEVEL=INFO
# HRMS_SENTRY_DSN=                         # error tracking; off when unset
# HRMS_SENTRY_ENVIRONMENT=staging
# HRMS_SENTRY_TRACES_SAMPLE_RATE=0
# HRMS_METRICS_ENABLED=true               # GET /metrics for Prometheus
# HRMS_METRICS_TOKEN=                      # required in production while metrics are enabled
