# Copy to backend/.env for local development. Every setting is prefixed HRMS_.
# In production and testing set these in the environment (not a committed file) — see docs/ENVIRONMENTS.md.

# ── Database ────────────────────────────────────────────────────────────────
# Owner/superuser connection: migrations and scripts in backend/scripts/ only (needs DDL rights).
HRMS_DATABASE_URL=postgresql+asyncpg://hrms:hrms@localhost:5432/hrms

# The connection the RUNNING API uses: the restricted hrms_app role (NOSUPERUSER, NOBYPASSRLS), so
# Postgres row-level security enforces tenant isolation. Required when HRMS_ENVIRONMENT != local,
# and its password must not be the published development one.
HRMS_APP_DATABASE_URL=postgresql+asyncpg://hrms_app:hrms_app_dev_password@localhost:5432/hrms
# Password migration 0005 gives hrms_app when it first creates the role (default: hrms_app_dev_password).
# HRMS_APP_ROLE_PASSWORD=

# The platform console's role (hrms_platform, migration 0061): the only login that can reach
# platform_admins, their reset tokens and the platform audit log. Required when HRMS_ENVIRONMENT != local.
HRMS_PLATFORM_DATABASE_URL=postgresql+asyncpg://hrms_platform:hrms_platform_dev_password@localhost:5432/hrms
# Password migration 0061 gives hrms_platform when it creates the role (default: hrms_platform_dev_password).
# HRMS_PLATFORM_ROLE_PASSWORD=

# Connection pool settings
# HRMS_DATABASE_POOL_SIZE=10
# HRMS_DATABASE_MAX_OVERFLOW=20
# HRMS_DATABASE_POOL_TIMEOUT_SECONDS=10

# ── Security ────────────────────────────────────────────────────────────────
# local | testing | production — see docs/ENVIRONMENTS.md (testing holds real data: all safeguards).
# Deployed environments refuse to start with default/short signing key, debug on, or dev passwords.
HRMS_ENVIRONMENT=local
HRMS_SECRET_KEY=dev-secret-change-before-production-min-32-chars
HRMS_DEBUG=false
HRMS_CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://testhrms.alvision.in,https://testhrmsapi.alvision.in,https://testinghrms.alvision.in,https://hrmsapi.alvision.in

# Encryption at rest for Aadhaar, PAN, bank account … (core/field_crypto.py):
#   python3 -c "import os,base64;print('k1:'+base64.urlsafe_b64encode(os.urandom(32)).decode())"
# Unset = the published local development key, which deployed environments refuse.
HRMS_FIELD_ENCRYPTION_KEYS=k1:RwMRi6sWiwEzy7F9ysEbuXLBgEggy0TqEPAwW8y6Vss=

# Salaries (own keys + pepper, core/field_crypto.py). Unset locally = published development keys.
# Deployed environments require both; generate them as in deploy/env/production.env.example.
# HRMS_PAYROLL_ENCRYPTION_KEYS=
# HRMS_PAYROLL_PEPPER=

# Sign-in protection (counted in the database, so it holds across workers and restarts).
# HRMS_LOGIN_MAX_FAILURES=5              # wrong passwords per identifier+address before a lockout
# HRMS_LOGIN_IDENTIFIER_MAX_FAILURES=25  # … per identifier from any address
# HRMS_LOGIN_IP_MAX_FAILURES=100         # … per address (generous: a factory can share one)
# HRMS_LOGIN_LOCKOUT_MINUTES=15
# HRMS_REGISTER_MAX_PER_HOUR=5           # anonymous company registrations per address
# HRMS_ALLOW_PUBLIC_REGISTRATION=true    # set false once tenants are created from the platform console

# ── Uploaded documents ──────────────────────────────────────────────────────
# local = storage/ directory. s3 = S3 (or S3-compatible) bucket — recommended for production.
HRMS_DOCUMENT_STORAGE=local
# HRMS_DOCUMENT_S3_BUCKET=
# HRMS_DOCUMENT_S3_REGION=ap-south-1
# HRMS_STORAGE_DIR=storage

# ── Attendance & Jobs Fallback ──────────────────────────────────────────────
# Used only when no policy template applies to an employee, their department, company or tenant.
# Prefer giving each tenant its own default template (Policies → templates).
# HRMS_DEFAULT_TIMEZONE=Asia/Kolkata
# HRMS_DEFAULT_WORK_START=09:30
# HRMS_DEFAULT_WORK_END=18:30
# HRMS_DEFAULT_GRACE_LATE_MINUTES=15
# HRMS_DEFAULT_GRACE_EARLY_MINUTES=15
# HRMS_JOBS_DAILY_AT=00:30

# ── Observability (docs/OBSERVABILITY.md) ────────────────────────────────────
# HRMS_LOG_FORMAT=console                  # json in production (the default there)
# HRMS_LOG_LEVEL=INFO
# HRMS_SENTRY_DSN=                         # error tracking; off when unset
# HRMS_SENTRY_ENVIRONMENT=staging
# HRMS_SENTRY_TRACES_SAMPLE_RATE=0
# HRMS_METRICS_ENABLED=true               # GET /metrics for Prometheus
# HRMS_METRICS_TOKEN=                      # required in production/testing while metrics are enabled
