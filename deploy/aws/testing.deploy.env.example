# Non-secret Compose interpolation. Install as /etc/hrms/testing.deploy.env, mode 600.
HRMS_WEB_API_URL=https://hrmsapi.alvision.in
HRMS_API_PORT=8115
HRMS_WEB_PORT=8180
# Host reverse proxy / Cloudflare tunnel. For ALB use 0.0.0.0 and restrict the EC2 SG to the ALB SG.
HRMS_BIND_ADDRESS=127.0.0.1
HRMS_FORWARDED_ALLOW_IPS=172.30.25.1
HRMS_API_MEMORY=1g
