# Only the one-shot migration container receives this file. Install as /etc/hrms/testing.migrate.env (600).
# The owner must pass database-preflight.py; see docs/AWS_TESTING_CICD.md for the RDS/RLS requirement.
HRMS_DATABASE_URL=postgresql+asyncpg://Hrms:REPLACE_URL_ENCODED_OWNER_PASSWORD@hrmstest.crgowckyse2b.ap-south-1.rds.amazonaws.com:5432/hrms_testing?ssl=verify-full
# Generate distinct secrets: openssl rand -hex 32. These must match the two runtime connection URLs.
HRMS_APP_ROLE_PASSWORD=REPLACE_APP_PASSWORD
HRMS_PLATFORM_ROLE_PASSWORD=REPLACE_PLATFORM_PASSWORD
