# Literal KEY=value, without shell quotes or export. Install as /etc/hrms/testing.runtime.env (600).
# API/jobs receive only restricted credentials. Percent-encode passwords in connection URLs.
HRMS_DATABASE_URL=postgresql+asyncpg://hrms_app:REPLACE_APP_PASSWORD@hrmstest.crgowckyse2b.ap-south-1.rds.amazonaws.com:5432/hrms_testing?ssl=verify-full
HRMS_APP_DATABASE_URL=postgresql+asyncpg://hrms_app:REPLACE_APP_PASSWORD@hrmstest.crgowckyse2b.ap-south-1.rds.amazonaws.com:5432/hrms_testing?ssl=verify-full
HRMS_PLATFORM_DATABASE_URL=postgresql+asyncpg://hrms_platform:REPLACE_PLATFORM_PASSWORD@hrmstest.crgowckyse2b.ap-south-1.rds.amazonaws.com:5432/hrms_testing?ssl=verify-full
HRMS_SECRET_KEY=REPLACE_WITH_64_HEX_CHARACTERS
HRMS_METRICS_TOKEN=REPLACE_WITH_DIFFERENT_64_HEX_CHARACTERS
# k1:<base64url-encoded 32 random bytes>. Keep this key with your recovery records.
HRMS_FIELD_ENCRYPTION_KEYS=REPLACE_ENCRYPTION_KEY
HRMS_CORS_ORIGINS=https://testinghrms.alvision.in
HRMS_ALLOW_PUBLIC_REGISTRATION=false
HRMS_API_DOCS_ENABLED=false
HRMS_DATABASE_POOL_SIZE=5
HRMS_DATABASE_MAX_OVERFLOW=5
HRMS_DEFAULT_TIMEZONE=Asia/Kolkata
HRMS_JOBS_DAILY_AT=00:30
WEB_CONCURRENCY=2
# Encrypted uploads persist in the named Docker volume. Back this volume up, or use a versioned S3 bucket.
HRMS_DOCUMENT_STORAGE=local
HRMS_MAIL_BACKEND=disabled
