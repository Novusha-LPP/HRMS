# HRMS production environment — copy to deploy/env/production.env (gitignored) and fill in.
# The live deployment. Replace the example hostnames with the production ones.
# Used by docker compose (--env-file) for interpolation AND passed to the API/jobs containers.
# Generate every secret with:  openssl rand -hex 32   (URL-safe; no quoting needed)

HRMS_ENVIRONMENT=production
HRMS_ENV_FILE=env/production.env
# A released version (git tag without the v): images ghcr.io/novusha-lpp/hrms/{api,web}:<version>
HRMS_VERSION=0.1.0

# ── Secrets ───────────────────────────────────────────────────────────────────
HRMS_DB_OWNER_PASSWORD=
HRMS_APP_ROLE_PASSWORD=
HRMS_SECRET_KEY=
HRMS_METRICS_TOKEN=
# HRMS_SENTRY_DSN=
# HRMS_WEB_SENTRY_DSN=

# ── Addresses ─────────────────────────────────────────────────────────────────
# Host ports (bound to 127.0.0.1) that the Cloudflare tunnel / reverse proxy points at.
HRMS_API_PORT=8215
HRMS_WEB_PORT=8280
HRMS_WEB_API_URL=https://api.hrms.example.com
HRMS_CORS_ORIGINS=https://hrms.example.com

# ── Behaviour ─────────────────────────────────────────────────────────────────
HRMS_ALLOW_PUBLIC_REGISTRATION=false
HRMS_API_DOCS_ENABLED=false
HRMS_LOG_LEVEL=INFO
HRMS_DEFAULT_TIMEZONE=Asia/Kolkata
HRMS_JOBS_DAILY_AT=00:30
# Workers per API container (CPU-bound work in one request must not stall the rest).
WEB_CONCURRENCY=2

# ── Backups ───────────────────────────────────────────────────────────────────
# A host directory, ideally on another disk, that an off-site copy job also syncs.
HRMS_BACKUP_DIR=/srv/hrms-backups
HRMS_BACKUP_AT=01:30
HRMS_BACKUP_KEEP_DAYS=14
