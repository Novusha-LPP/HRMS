# HRMS testing environment — copy to deploy/env/testing.env (gitignored) and fill in.
# The shared test deployment. It holds REAL employee data: same safeguards as production.
# Used by docker compose (--env-file) for interpolation AND passed to the API/jobs containers.
# Generate every secret with:  openssl rand -hex 32   (URL-safe; no quoting needed)

HRMS_ENVIRONMENT=testing
HRMS_ENV_FILE=env/testing.env
# A released version (git tag without the v): images ghcr.io/novusha-lpp/hrms/{api,web}:<version>
HRMS_VERSION=0.1.0

# ── Secrets ───────────────────────────────────────────────────────────────────
HRMS_DB_OWNER_PASSWORD=
HRMS_APP_ROLE_PASSWORD=
# The platform console's database role (migration 0061); must differ from the others.
HRMS_PLATFORM_ROLE_PASSWORD=
HRMS_SECRET_KEY=
HRMS_METRICS_TOKEN=
# Encrypts Aadhaar, PAN, bank account … at rest: <id>:<32 random bytes, base64url>. Generate:
#   python3 -c "import os,base64;print('k1:'+base64.urlsafe_b64encode(os.urandom(32)).decode())"
# Rotating: put the new key FIRST, keep the old one after it, deploy (migrate re-encrypts).
# LOSING THIS KEY LOSES THE DATA: keep it in the password manager and with the backups' owner.
HRMS_FIELD_ENCRYPTION_KEYS=

# Salaries are encrypted with their OWN keys plus a pepper (core/field_crypto.py, "Payroll").
# Keep these two, and HRMS_FIELD_ENCRYPTION_KEYS, in three different places and share the payroll
# pair with as few people as possible: that is what keeps salaries from developers and DBAs.
#   keys:   python3 -c "import os,base64;print('p1:'+base64.urlsafe_b64encode(os.urandom(32)).decode())"
#   pepper: python3 -c "import secrets;print(secrets.token_urlsafe(48))"
# Rotating keys: new key FIRST, old after it, deploy (migrate re-encrypts). The pepper cannot be
# rotated by a deploy alone. LOSING EITHER ONE LOSES EVERY SALARY: store both with the backups' owner.
HRMS_PAYROLL_ENCRYPTION_KEYS=
HRMS_PAYROLL_PEPPER=
# HRMS_SENTRY_DSN=
# HRMS_WEB_SENTRY_DSN=

# ── Addresses ─────────────────────────────────────────────────────────────────
# Host ports (bound to 127.0.0.1) that the Cloudflare tunnel / reverse proxy points at.
HRMS_API_PORT=8115
HRMS_WEB_PORT=8180
HRMS_WEB_API_URL=https://testhrmsapi.alvision.in
HRMS_CORS_ORIGINS=https://testhrms.alvision.in

# ── Uploaded documents (always encrypted with the keys above) ─────────────────
# local = the kyc-storage volume. s3 = recommended for production (versioned bucket).
HRMS_DOCUMENT_STORAGE=local
# HRMS_DOCUMENT_S3_BUCKET=
# HRMS_DOCUMENT_S3_REGION=ap-south-1
# AWS_ACCESS_KEY_ID= / AWS_SECRET_ACCESS_KEY=   (or an instance role)

# ── Behaviour ─────────────────────────────────────────────────────────────────
HRMS_ALLOW_PUBLIC_REGISTRATION=false
HRMS_API_DOCS_ENABLED=true
HRMS_LOG_LEVEL=INFO
HRMS_DEFAULT_TIMEZONE=Asia/Kolkata
HRMS_JOBS_DAILY_AT=00:30
# Workers per API container (CPU-bound work in one request must not stall the rest).
WEB_CONCURRENCY=2

# ── Backups ───────────────────────────────────────────────────────────────────
# A host directory, ideally on another disk, that an off-site copy job also syncs.
HRMS_BACKUP_DIR=/srv/hrms-backups
HRMS_BACKUP_AT=01:30
HRMS_BACKUP_KEEP_DAYS=14

# Trust only the host tunnel's source as observed inside this bridge. Verify client IPs at cutover.
HRMS_BACKEND_SUBNET=172.30.15.0/24
HRMS_BACKEND_GATEWAY=172.30.15.1
HRMS_FORWARDED_ALLOW_IPS=172.30.15.1
HRMS_DATABASE_POOL_SIZE=5
HRMS_DATABASE_MAX_OVERFLOW=5
HRMS_API_MEMORY=1g
HRMS_DB_MEMORY=2g
# HRMS_MAIL_FROM=
# HRMS_MAIL_REGION=ap-south-1
# HRMS_PLATFORM_RESET_BASE_URL=https://testinghrms.alvision.in/platform/reset-password

# Enable only with a verified SES sender/account and IAM ses:SendEmail credentials.
HRMS_MAIL_BACKEND=disabled
HRMS_MAIL_FROM=
HRMS_MAIL_REGION=
HRMS_PLATFORM_RESET_BASE_URL=
