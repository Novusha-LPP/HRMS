# Copy to frontend/.env. Values are baked into the build.
# Local development:
VITE_API_URL=http://localhost:8015
# Remote testing deployment:
# VITE_API_URL=https://testhrmsapi.alvision.in
# Error tracking (Sentry); the SDK is only bundled when this is set. See docs/OBSERVABILITY.md.
# VITE_SENTRY_DSN=
# VITE_SENTRY_ENVIRONMENT=testing
