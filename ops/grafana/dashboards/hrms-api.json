{
  "title": "HRMS API",
  "uid": "hrms-api",
  "tags": [
    "hrms"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "1m",
  "editable": false,
  "templating": {
    "list": [
      {
        "name": "instance",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "label": "API instance",
        "query": "label_values(hrms_http_requests_total{job=\"hrms-api\"}, instance)",
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2,
        "allValue": ".*"
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "API availability",
      "description": "Current Prometheus scrape status for selected API instances.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "min(up{job=\"hrms-api\", instance=~\"$instance\"})",
          "refId": "A",
          "instant": true
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "noValue": "No data",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto"
      },
      "id": 1
    },
    {
      "type": "stat",
      "title": "Response time (p95)",
      "description": "95% of API requests finish within this time. Target: 300 ms. Health and metrics requests excluded.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(hrms_http_request_duration_seconds_bucket{job=\"hrms-api\", instance=~\"$instance\",route!~\"/health.*|/metrics\"}[$__rate_interval])))",
          "refId": "A",
          "instant": true
        }
      ],
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 2,
          "noValue": "No data",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.3
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto"
      },
      "id": 2
    },
    {
      "type": "stat",
      "title": "Server error rate",
      "description": "Share of API requests returning 5xx. No data means no matching requests in this interval.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum(rate(hrms_http_requests_total{job=\"hrms-api\", instance=~\"$instance\",status=~\"5..\"}[$__rate_interval])) or (0 * sum(rate(hrms_http_requests_total{job=\"hrms-api\", instance=~\"$instance\"}[$__rate_interval])))) / sum(rate(hrms_http_requests_total{job=\"hrms-api\", instance=~\"$instance\"}[$__rate_interval]))",
          "refId": "A",
          "instant": true
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "noValue": "No data",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.01
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto"
      },
      "id": 3
    },
    {
      "type": "stat",
      "title": "Active requests",
      "description": "Requests currently being served.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(hrms_http_requests_in_progress{job=\"hrms-api\",instance=~\"$instance\"})",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data",
          "decimals": 2,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "id": 4
    },
    {
      "type": "timeseries",
      "title": "Request traffic",
      "description": "API request rate, including client and server errors.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(hrms_http_requests_total{job=\"hrms-api\", instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "all",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(hrms_http_requests_total{job=\"hrms-api\", instance=~\"$instance\",status=~\"5..\"}[$__rate_interval]))",
          "legendFormat": "5xx",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(hrms_http_requests_total{job=\"hrms-api\", instance=~\"$instance\",status=~\"4..\"}[$__rate_interval]))",
          "legendFormat": "4xx",
          "refId": "C"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        }
      },
      "interval": "30s",
      "id": 5
    },
    {
      "type": "timeseries",
      "title": "Response times",
      "description": "Response-time distribution. Target p95: under 300 ms.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(hrms_http_request_duration_seconds_bucket{job=\"hrms-api\", instance=~\"$instance\",route!~\"/health.*|/metrics\"}[$__rate_interval])))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(hrms_http_request_duration_seconds_bucket{job=\"hrms-api\", instance=~\"$instance\",route!~\"/health.*|/metrics\"}[$__rate_interval])))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(hrms_http_request_duration_seconds_bucket{job=\"hrms-api\", instance=~\"$instance\",route!~\"/health.*|/metrics\"}[$__rate_interval])))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        }
      },
      "interval": "30s",
      "id": 6
    },
    {
      "type": "timeseries",
      "title": "Slowest endpoints",
      "description": "Find which endpoints cause slow responses.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "topk(10, histogram_quantile(0.95, sum by (le, method, route) (rate(hrms_http_request_duration_seconds_bucket{job=\"hrms-api\", instance=~\"$instance\",route!~\"/health.*|/metrics\"}[$__rate_interval]))))",
          "legendFormat": "{{method}} {{route}}",
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        }
      },
      "interval": "30s",
      "id": 7
    },
    {
      "type": "timeseries",
      "title": "Server errors by endpoint",
      "description": "An empty chart means no matching server-error series.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "interval": "30s",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "topk(10,sum by (method,route) (rate(hrms_http_requests_total{job=\"hrms-api\",instance=~\"$instance\",status=~\"5..\"}[$__rate_interval])))",
          "legendFormat": "{{method}} {{route}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "id": 8
    },
    {
      "type": "timeseries",
      "title": "Sign-in results",
      "description": "Sign-in success and failure rates. Sparse traffic may produce no data.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "interval": "30s",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (status) (rate(hrms_http_requests_total{job=\"hrms-api\",instance=~\"$instance\",route=\"/v1/auth/login\"}[$__rate_interval]))",
          "legendFormat": "HTTP {{status}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "id": 9
    },
    {
      "type": "table",
      "title": "Alerts needing attention",
      "description": "Current pending and firing alerts, including jobs, backups, security and infrastructure. An empty table means no active alerts.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "ALERTS{alertstate=~\"pending|firing\",alertname=~\"HrmsApiDown|HrmsHighErrorRate|HrmsSlowResponses|HrmsLogin.*\"}",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 1
        },
        "overrides": []
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "Value": true
            },
            "renameByName": {
              "Value": "Active",
              "job_name": "Job",
              "alertname": "Alert",
              "alertstate": "State",
              "severity": "Severity",
              "instance": "Instance"
            }
          }
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        },
        "sortBy": []
      },
      "id": 10
    }
  ],
  "description": "API traffic, latency, failures and slow endpoints.",
  "links": [
    {
      "title": "Overview",
      "url": "/d/hrms-overview",
      "type": "link",
      "keepTime": true,
      "includeVars": true,
      "targetBlank": false
    },
    {
      "title": "Database",
      "url": "/d/hrms-db",
      "type": "link",
      "keepTime": true,
      "includeVars": true,
      "targetBlank": false
    },
    {
      "title": "Infrastructure",
      "url": "/d/hrms-infra",
      "type": "link",
      "keepTime": true,
      "includeVars": true,
      "targetBlank": false
    }
  ],
  "version": 1
}
