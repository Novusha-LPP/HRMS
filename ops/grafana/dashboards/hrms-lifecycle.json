{
  "title": "HRMS Employment Lifecycle",
  "uid": "hrms-lifecycle",
  "tags": [
    "hrms"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "1m",
  "editable": false,
  "templating": {
    "list": [
      {
        "name": "instance",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "label": "API instance",
        "query": "label_values(hrms_http_requests_total{job=\"hrms-api\"}, instance)",
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2,
        "allValue": ".*"
      },
      {
        "name": "host",
        "label": "Host",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(up{job=\"hrms-host\"}, instance)",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2
      }
    ]
  },
  "description": "Combined operational health: API, database, infrastructure, jobs and alerts.",
  "links": [
    {
      "title": "API",
      "url": "/d/hrms-api",
      "type": "link",
      "keepTime": true,
      "includeVars": true,
      "targetBlank": false
    },
    {
      "title": "Database",
      "url": "/d/hrms-db",
      "type": "link",
      "keepTime": true,
      "includeVars": true,
      "targetBlank": false
    },
    {
      "title": "Infrastructure",
      "url": "/d/hrms-infra",
      "type": "link",
      "keepTime": true,
      "includeVars": true,
      "targetBlank": false
    }
  ],
  "version": 1,
  "panels": [
    {
      "type": "timeseries",
      "title": "Rejoins per day",
      "description": "People who rejoined, by whether earlier service continued (CONTINUE) or started over (FRESH).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (mode) (increase(hrms_rejoins_total[1d]))",
          "legendFormat": "{{mode}}",
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        }
      },
      "interval": "30s",
      "id": 1
    },
    {
      "type": "timeseries",
      "title": "Leave settled when people leave",
      "description": "Unused leave balances settled on separation, by what was done: lapsed, encashed or held.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (action) (increase(hrms_leave_separation_settlements_total[1d]))",
          "legendFormat": "{{action}}",
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        }
      },
      "interval": "30s",
      "id": 2
    },
    {
      "type": "timeseries",
      "title": "Held leave resolved",
      "description": "Held balances closed by the daily job: lapsed after the hold, or restored because the person rejoined.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (outcome) (increase(hrms_leave_holds_resolved_total[1d]))",
          "legendFormat": "{{outcome}}",
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        }
      },
      "interval": "30s",
      "id": 3
    },
    {
      "type": "timeseries",
      "title": "Company transfers and refused duplicate hires",
      "description": "People moved between companies, and hires refused because the person already had an employment.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (leave_mode) (increase(hrms_company_transfers_total[1d]))",
          "legendFormat": "transfers {{leave_mode}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(hrms_hire_past_employment_refused_total[1d]))",
          "legendFormat": "duplicate hires refused",
          "refId": "B"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        }
      },
      "interval": "30s",
      "id": 4
    }
  ]
}